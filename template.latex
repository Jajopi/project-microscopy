% Build with:
%   pandoc -f markdown-implicit_figures --shift-heading-level-by=-1 \
%     README.md --template=template.latex -o report.pdf
% -f markdown-implicit_figures: without this, standalone images become
%   auto-captioned LaTeX figures, duplicating the manual "> **Fig. N. ...**"
%   captions already used in the document.
% --shift-heading-level-by=-1: without this, since the document's top-level
%   heading is "##" (level 2), pandoc emits \subsection for it, nested under
%   a phantom, invisible "section 0" (numbering shows as "0.1", "0.2", ...).
\documentclass[11pt]{article}

% Standard Latin Modern (Computer Modern look-alike) text setup - matches
% example_work.pdf, which was itself built with pdfTeX and default CM-family fonts.
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage{lmodern}

\usepackage[a4paper,margin=2cm]{geometry}

\usepackage{graphicx}
\usepackage{amsmath}
\usepackage{fancyhdr}

% Table support, as required by pandoc's own longtable output.
\usepackage{longtable,booktabs,array}
\usepackage{caption}
\captionsetup[table]{skip=6pt}
\newcounter{none} % for unnumbered tables
\usepackage{calc} % for calculating minipage widths
\usepackage{etoolbox}
\makeatletter
\patchcmd\longtable{\par}{\if@noskipsec\mbox{}\fi\par}{}{}
\makeatother
\IfFileExists{footnotehyper.sty}{\usepackage{footnotehyper}}{\usepackage{footnote}}
\makesavenoteenv{longtable}

% Pandoc wraps every image in \pandocbounded{...} to scale it to fit the text
% height/width; this is pandoc's own definition (from its default template),
% modified here to cap width at 2/3 of the line width (instead of the full
% width) and to center the result, since a narrower image would otherwise
% still sit flush against the left margin.
\makeatletter
\newsavebox\pandoc@box
\newcommand*\pandocbounded[1]{%
  \vspace{\baselineskip}%
  \sbox\pandoc@box{#1}%
  \Gscale@div\@tempa{\textheight}{\dimexpr\ht\pandoc@box+\dp\pandoc@box\relax}%
  \Gscale@div\@tempb{0.667\linewidth}{\wd\pandoc@box}%
  \ifdim\@tempb\p@<\@tempa\p@\let\@tempa\@tempb\fi% select the smaller of both
  \ifdim\@tempa\p@<\p@\centerline{\scalebox{\@tempa}{\usebox\pandoc@box}}%
  \else\centerline{\usebox{\pandoc@box}}%
  \fi%
}
\def\fps@figure{htbp}
\makeatother

\usepackage[colorlinks=true,linkcolor=blue,citecolor=blue,urlcolor=blue]{hyperref}

% Render footnotes as a classical numbered reference list ("[1]", "[2]", ...)
% instead of page-bottom footnotes, hyperlinked in both directions. Pandoc
% emits plain \footnote{...} for markdown [^n] footnotes; redefining that
% macro here collects the note text instead of typesetting it in place, to be
% printed later by \printreferences - placed at the end of the body, where it
% lands right under the "References and links" heading (that heading is
% otherwise empty, since footnote *definitions* like [^1]: ... aren't
% rendered as visible body text).
% \hypertarget/\hyperlink (not \label/\ref) are used so this works in a
% single compilation pass, since pandoc's invocation only runs pdflatex once.
% \referencelist is rebuilt with \edef on every footnote call, so \thereflink
% is expanded to its actual digit(s) right away - appending it unexpanded
% (e.g. via plain \appto) would store the token "\thereflink" itself in the
% list, and since all entries share the same counter, every entry would print
% whatever the *final* counter value happened to be (all "[3]" instead of
% "[1]", "[2]", "[3]") once \referencelist is finally used at the end.
% \unexpanded\expandafter{\referencelist} splices in the *old* accumulated
% body as inert tokens (expanding \referencelist by one level, then blocking
% any further expansion of what it contains) - needed because \hypertarget/
% \hyperlink are old-style "robust" commands (\DeclareRobustCommand), which
% \edef does NOT leave alone by default the way it does \protected commands;
% re-expanding an already-resolved \hypertarget/\hyperlink call a second time
% breaks hyperref's internals. The newly-added \hypertarget/\hyperlink calls
% are shielded from this same \edef the same way, via \noexpand. \unexpanded{#1}
% likewise keeps the footnote text itself from being expanded.
\newcounter{reflink}
\newcommand{\referencelist}{}
\renewcommand{\footnote}[1]{%
  \refstepcounter{reflink}%
  \hypertarget{refcite\thereflink}{}%
  [\hyperlink{refnote\thereflink}{\thereflink}]%
  \edef\referencelist{%
    \unexpanded\expandafter{\referencelist}%
    \noexpand\par\noexpand\noindent
    \noexpand\hypertarget{refnote\thereflink}{}%
    \hangindent=1.8em\hangafter=1
    [\noexpand\hyperlink{refcite\thereflink}{\thereflink}]~\unexpanded{#1}\noexpand\par
  }%
}
\newcommand{\printreferences}{\footnotesize\referencelist}

$if(highlighting-macros)$
$highlighting-macros$
$endif$

% Pandoc emits this for compact (tight) lists.
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% Running header: small-caps author name, right-aligned, with a rule under it;
% centered page number at the bottom, with a rule above it - matches example_work.pdf.
\pagestyle{fancy}
\fancyhf{}
\fancyhead[R]{\scshape $for(author)$$author$$sep$, $endfor$}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}

% First page has no header/footer/rules, only the title block below.
\fancypagestyle{firstpage}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

\setlength{\parindent}{1em}

\begin{document}

\thispagestyle{firstpage}
\begin{center}
  {\LARGE $title$ \par}
  \vspace{1em}
  {\large $for(author)$$author$$sep$, $endfor$ \par}
  \vspace{0.4em}
  $if(affiliation)$
  {\itshape $affiliation$ \par}
  $endif$
  $if(project)$
  {\itshape $project$ \par}
  $endif$
\end{center}
\vspace{1.5em}

$body$

\printreferences

\end{document}
